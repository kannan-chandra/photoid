---
import PhotoCreator from '../components/PhotoCreator.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const favicon = `${base}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Create and print US passport photos privately in your browser." />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>Passport Photo Maker</title>
  </head>
  <body>
    <main class="app-shell">
      <header>
        <p class="eyebrow">2 × 2 INCH PHOTO</p>
        <h1>Passport photo maker</h1>
        <p class="intro">Upload a photo and generate compliant print-ready 2x2 images</p>
      </header>
      <PhotoCreator mode="full" />
    </main>
  </body>
</html>
