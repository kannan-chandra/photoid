---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Create and print US passport photos privately in your browser." />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <title>Passport Photo Maker</title>
  </head>
  <body>
    <main class="app-shell">
      <header>
        <p class="eyebrow">2 × 2 INCH PHOTO</p>
        <h1>Passport photo maker</h1>
        <p class="intro">Position one photo, then download a print-ready 4×6 sheet.</p>
      </header>

      <section class="card" aria-labelledby="choose-heading">
        <div class="step-heading">
          <span aria-hidden="true">1</span>
          <div>
            <h2 id="choose-heading">Choose your photo</h2>
            <p>Your photo stays on your device.</p>
          </div>
        </div>
        <div class="drop-zone" id="drop-zone">
          <p><strong>Drop a photo here</strong><span>or</span></p>
          <label class="upload-button" for="photo-input">Choose or take a photo</label>
          <input id="photo-input" type="file" accept="image/*,.heic,.heif" capture="environment" />
        </div>
        <p class="hint">JPEG, PNG, WebP, HEIC, or HEIF. Use a clear, recent photo with even lighting and a plain background.</p>
      </section>

      <section class="card editor-card" id="editor-section" aria-labelledby="position-heading" hidden>
        <div class="step-heading">
          <span aria-hidden="true">2</span>
          <div>
            <h2 id="position-heading">Position your photo</h2>
            <p>Drag to move. Use the slider to zoom.</p>
          </div>
        </div>

        <div class="editor-layout">
          <div>
            <div class="crop-frame" id="crop-frame" aria-label="Photo positioning area">
              <img id="editor-image" alt="Photo being positioned" draggable="false" />
              <div class="passport-guide" aria-hidden="true">
                <div class="head-oval"></div>
                <div class="eye-line"><span>EYES</span></div>
              </div>
            </div>
            <label class="zoom-control" for="zoom-input">
              <span>Zoom</span>
              <input id="zoom-input" type="range" min="1" max="3" step="0.01" value="1" />
            </label>
          </div>

          <div class="preview-panel">
            <h3>2×2 preview</h3>
            <canvas id="crop-preview" width="300" height="300" aria-label="Passport photo crop preview"></canvas>
            <p>The guide is for positioning only and won’t appear in your download.</p>
          </div>
        </div>

        <div class="export-panel">
          <div class="sheet-icon" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
          <div>
            <h3>4×6 print sheet</h3>
            <p>Six exact 2×2 photos at 300 DPI, with cut guides.</p>
          </div>
          <button class="download-button" id="download-button" type="button">Download 4×6 JPEG</button>
        </div>
        <p class="print-note"><strong>When printing:</strong> choose 4×6 paper and “Fit” or “Full image.” Turn off cropping or “Fill.”</p>
      </section>
      <p class="error-message" id="error-message" role="alert" hidden></p>
    </main>
    <script>
      import { PhotoEditor } from '../lib/photo-editor';
      import { downloadBlob, renderPassportSheet } from '../lib/sheet-renderer';

      const input = document.querySelector<HTMLInputElement>('#photo-input')!;
      const dropZone = document.querySelector<HTMLElement>('#drop-zone')!;
      const section = document.querySelector<HTMLElement>('#editor-section')!;
      const error = document.querySelector<HTMLElement>('#error-message')!;
      const downloadButton = document.querySelector<HTMLButtonElement>('#download-button')!;
      const editor = new PhotoEditor(
        document.querySelector<HTMLElement>('#crop-frame')!,
        document.querySelector<HTMLImageElement>('#editor-image')!,
        document.querySelector<HTMLInputElement>('#zoom-input')!,
        document.querySelector<HTMLCanvasElement>('#crop-preview')!,
      );

      const openPhoto = async (file?: File) => {
        if (!file) return;
        error.hidden = true;
        section.hidden = false;
        section.setAttribute('aria-busy', 'true');
        try {
          await editor.load(file);
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (cause) {
          section.hidden = true;
          error.textContent = cause instanceof Error ? cause.message : 'That image could not be opened.';
          error.hidden = false;
        } finally {
          section.removeAttribute('aria-busy');
        }
      };

      input.addEventListener('change', () => openPhoto(input.files?.[0]));
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.add('is-dragging');
        });
      });
      ['dragleave', 'drop'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.remove('is-dragging');
        });
      });
      dropZone.addEventListener('drop', (event) => openPhoto(event.dataTransfer?.files[0]));

      downloadButton.addEventListener('click', async () => {
        downloadButton.disabled = true;
        downloadButton.textContent = 'Creating JPEG…';
        error.hidden = true;
        try {
          const blob = await renderPassportSheet(editor.getSnapshot());
          downloadBlob(blob, 'passport-photos-4x6.jpg');
        } catch (cause) {
          error.textContent = cause instanceof Error ? cause.message : 'The print sheet could not be created.';
          error.hidden = false;
        } finally {
          downloadButton.disabled = false;
          downloadButton.textContent = 'Download 4×6 JPEG';
        }
      });
    </script>
  </body>
</html>
